{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "geradorCertificado-app-api",
    "Audience": "geradorCertificado-app-client",
    "AccessTokenMinutes": 60
  },
  "NewRelic": {
    "Enabled": true,
    "EndpointUrl": "https://log-api.newrelic.com/log/v1",
    "ApplicationName": "geradorCertificado-app-prod"
  },
  "AllowedHosts": "*"
}
